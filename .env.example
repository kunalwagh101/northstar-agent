# Runtime
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# AI provider: "openai" uses an OpenAI-compatible Chat Completions API.
# "demo" runs the deterministic offline behaviour engine used by tests.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
FALLBACK_TO_DEMO=true

# Memory and abuse controls
SESSION_TTL_MINUTES=60
MAX_SESSIONS=1000
MAX_MESSAGES_PER_SESSION=80
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Booking simulation
BOOKING_TIMEZONE=Asia/Kolkata
