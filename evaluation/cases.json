[
  {
    "id": "qualified_booking_success",
    "description": "English buyer shares requirements and books an available site visit.",
    "channel": "chat",
    "messages": [
      "I want a 3 BHK",
      "My budget is 2 crore",
      "It is for self-use",
      "I want to buy within 3 months",
      "Book a site visit tomorrow at 11 am"
    ],
    "expect": {
      "status": "completed",
      "language": "english",
      "configuration": "3 BHK",
      "budget_crore": 2.0,
      "purchase_purpose": "self-use",
      "site_visit_status": "booked",
      "reply_contains": ["confirmed", "Saturday, 22 August"],
      "reply_excludes": ["discount", "availability guaranteed"],
      "minimum_lead_score": 80
    }
  },
  {
    "id": "hinglish_price_objection",
    "description": "Hinglish buyer finds the price expensive; agent does not invent a discount.",
    "channel": "chat",
    "messages": [
      "Mujhe 2 BHK chahiye",
      "Yeh mere liye bahut mehenga hai"
    ],
    "expect": {
      "status": "active",
      "language": "hinglish",
      "configuration": "2 BHK",
      "objection": "price",
      "reply_contains": ["confirmed discount nahi"],
      "reply_excludes": ["special offer", "I can reduce"]
    }
  },
  {
