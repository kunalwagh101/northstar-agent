  {
    "id": "unknown_amenities",
    "description": "Agent admits it lacks confirmed amenities information and offers escalation.",
    "channel": "chat",
    "messages": ["Does the project have a swimming pool and gym?"],
    "expect": {
      "status": "active",
      "language": "english",
      "intent": "unknown_amenities",
      "unknown_question_count": 1,
      "reply_contains": ["don’t have confirmed information", "sales adviser"],
      "reply_excludes": ["yes", "includes a pool"]
    }
  },
  {
    "id": "booking_failure",
